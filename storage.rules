rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function groupMember(groupId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == 'active';
    }

    function allowedGroupFile() {
      return request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          || request.resource.contentType == 'application/vnd.ms-powerpoint'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation'
          || request.resource.contentType == 'application/vnd.ms-excel'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
          || request.resource.contentType == 'text/csv'
        );
    }

    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if signedIn()
        && request.auth.uid == uid
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /groups/{groupId}/avatar/{fileName} {
      allow read: if true;
      allow write: if signedIn()
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /groups/{groupId}/collections/{collectionId}/payments/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /groups/{groupId}/collections/{collectionId}/media/{fileName} {
      allow read: if true;
      allow write: if signedIn()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /groups/{groupId}/resources/{fileName} {
      allow read: if groupMember(groupId);
      allow write: if groupMember(groupId)
        && allowedGroupFile();
    }

    match /groups/{groupId}/chat/{fileName} {
      allow read: if groupMember(groupId);
      allow write: if groupMember(groupId)
        && allowedGroupFile();
    }

    // ID photos for student / landlord verification (App.js). Private to the
    // owner and the Kampasika admin. Before this, the catch-all below made
    // them publicly readable.
    match /verification/{uid}/{fileName} {
      allow read: if signedIn()
        && (request.auth.uid == uid || request.auth.uid == 'LTrwUHH6utQJGiw4lcsKflzXvPR2');
      allow write: if signedIn()
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ─── Kampasika Biz: operator compliance documents ───
    // BRELA certificate, TIN, owner ID, licence. Private to the owner and the
    // Kampasika admin (same UID as isAdmin() in firestore.rules).
    match /biz/{operatorId}/documents/{fileName} {
      allow read: if signedIn()
        && (request.auth.uid == operatorId || request.auth.uid == 'LTrwUHH6utQJGiw4lcsKflzXvPR2');
      allow write: if signedIn()
        && request.auth.uid == operatorId
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );
    }

    // Catch-all for older paths. Storage, like Firestore, allows access if
    // ANY matching rule allows it, so this excludes biz/ explicitly —
    // otherwise operator documents would be publicly readable.
    match /{topDir}/{allPaths=**} {
      allow read: if !(topDir in ['biz', 'verification']);
      allow write: if !(topDir in ['biz', 'verification'])
        && signedIn()
        && request.resource.size < 12 * 1024 * 1024;
    }
  }
}
