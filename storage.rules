rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if signedIn()
        && request.auth.uid == uid
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /groups/{groupId}/avatar/{fileName} {
      allow read: if true;
      allow write: if signedIn()
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /groups/{groupId}/collections/{collectionId}/payments/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /groups/{groupId}/collections/{collectionId}/media/{fileName} {
      allow read: if true;
      allow write: if signedIn()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if signedIn()
        && request.resource.size < 12 * 1024 * 1024;
    }
  }
}
